NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
# Web build: search indexing is OFF by default. Leave false until public launch.
VITE_INDEXABLE=false
# Exact IPs of immediate reverse proxies allowed to set X-Forwarded-For (empty = trust none).
# Proxies must append/overwrite the actual client IP; restrict direct access to the API.
TRUSTED_PROXY_IPS=
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
PAIRING_PEPPER=replace-with-a-different-random-secret-at-least-32-characters
DATABASE_PATH=./data/minemories.sqlite
S3_ENDPOINT=http://127.0.0.1:3900
S3_ACCESS_KEY=GK0123456789abcdef0123456789abcdef
S3_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
S3_BUCKET=minemories
S3_REGION=garage
# Persistent temporary files for resumable uploads; keep this volume with the database.
UPLOADS_PATH=./data/uploads
# Per-account GLB bytes, including trash, reserved uploads and pending deletions (default 2 GiB).
ACCOUNT_STORAGE_BYTES=2147483648

# Cold storage is not activated yet. Future adapters require explicit provider/class configuration.
# Never change the S3 target of a bound cold-storage catalog without migrating its physical objects.
COLD_STORAGE_PROVIDER=off
# COLD_STORAGE_CLASS=GLACIER

# Better Auth user IDs allowed to review public submissions; empty keeps every submission pending.
PUBLIC_MODERATOR_IDS=

# Better Auth user IDs allowed to read and triage private technical diagnostics (not gallery moderators).
# Empty denies all web access. Players must separately opt in from their paired mod.
DIAGNOSTICS_OPERATOR_IDS=
DIAGNOSTICS_ENABLED=true
DIAGNOSTICS_RETENTION_DAYS=14
