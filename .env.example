NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
# Web build: search indexing is OFF by default. Leave false until public launch.
VITE_INDEXABLE=false
# Exact IPs of immediate reverse proxies allowed to set X-Forwarded-For (empty = trust none).
# Proxies must append/overwrite the actual client IP; restrict direct access to the API.
TRUSTED_PROXY_IPS=
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
PAIRING_PEPPER=replace-with-a-different-random-secret-at-least-32-characters
# Optional OAuth; configure the callback at BETTER_AUTH_URL/api/auth/callback/google or /discord.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DATABASE_PATH=./data/minemories.sqlite
S3_ENDPOINT=http://127.0.0.1:3900
S3_ACCESS_KEY=GK0123456789abcdef0123456789abcdef
S3_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
S3_BUCKET=minemories
S3_REGION=garage
# Mod JARs (distribution maison). Bucket distinct de S3_BUCKET; the API reads it and, when MOD_UPLOAD_TOKEN is
# set, also writes it. MOD_S3_ENDPOINT / MOD_S3_REGION / MOD_S3_ACCESS_KEY / MOD_S3_SECRET_KEY override the S3_*
# values for the `bun mod` release tool only (VPS mode); the API always uses S3_*.
MOD_STORAGE_BUCKET=minemories-mods
# Optional key prefix for every mod object (index, jars, latest/, retention). Empty = keys at the bucket root.
# Format: empty, or ONE level [a-z0-9][a-z0-9-]*/ (1-40 chars, ending with /), e.g. public-mods/. Anything else
# makes the API and `bun mod` refuse to start. Production options: (1) MOD_STORAGE_BUCKET=minemories-mods with no
# prefix, or (2) when a bucket cannot be created: MOD_STORAGE_BUCKET=<S3_BUCKET value, e.g. minemories> and
# MOD_STORAGE_PREFIX=public-mods/. In (2) the mods share the private captures bucket, isolated only by the prefix.
MOD_STORAGE_PREFIX=
# Versions kept per target after an upload or `bun mod storage prune` (latest, pinned and published ones are never removed).
MOD_STORAGE_KEEP=3
# Enables PUT /downloads/upload/<id>/<version> (build on a PC, upload through the API). Empty or shorter than
# 32 characters = route disabled (404). Generate with `openssl rand -hex 32`. Single API instance only. Never commit it.
MOD_UPLOAD_TOKEN=
# Largest accepted JAR, in bytes (default 16 MiB).
MOD_UPLOAD_MAX_BYTES=16777216
# Public index cache on the API, in milliseconds.
MOD_INDEX_CACHE_MS=15000
# Release tool only (PC): API that receives the JARs (`bun mod release --remote`, `bun mod push`, `bun mod status --remote`).
# MOD_API_URL=https://api.minemories.net
# Machine that builds: pc (default) or vps; recorded as `builtBy` in manifest.json and in the public index.
# MOD_BUILT_BY=pc
# Persistent temporary files for resumable uploads; keep this volume with the database.
UPLOADS_PATH=./data/uploads
# Per-account GLB bytes, including trash, reserved uploads and pending deletions (default 2 GiB).
ACCOUNT_STORAGE_BYTES=2147483648

# Cold storage is opt-in; configuring aws or r2 activates background archive/restore operations.
# Never change the S3 target of a bound cold-storage catalog without migrating its physical objects.
COLD_STORAGE_PROVIDER=off
# COLD_STORAGE_CLASS=GLACIER
# COLD_STORAGE_INACTIVE_DAYS=90

# Better Auth user IDs promoted to administrator once at API start (an existing account; a later demotion is kept).
ADMIN_BOOTSTRAP_USER_IDS=

# Public-gallery moderation and private diagnostics are reserved to administrators (accounts promoted in the admin area): no ID list here.
# Players must separately opt in to diagnostics from their paired mod.
DIAGNOSTICS_ENABLED=true
DIAGNOSTICS_RETENTION_DAYS=14

# Payments remain disabled until the owner approves the commercial offer and provider setup (#80, #63, #89).
POLAR_ENVIRONMENT=off

# Optional public-page web diagnostics. Empty means no SDK or telemetry network.
# Requires per-browser consent on /privacy. Use a public HTTPS Sentry DSN, never an API token.
VITE_WEB_DIAGNOSTICS_DSN=
