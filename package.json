{
	"name": "minemories",
	"private": true,
	"packageManager": "bun@1.4.4",
	"engines": {
		"bun": ">=1.4.2",
		"node": "^22.22.2 || ^24.15.0 || >=26.0.0"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"trustedDependencies": [
		"@biomejs/biome",
		"esbuild",
		"rolldown"
	],
	"scripts": {
		"mod:dev": "node scripts/gradle.mjs :neoforge:runClient",
		"mod:build": "node scripts/gradle.mjs build",
		"mod:check": "node scripts/gradle.mjs spotlessApply check",
		"mod:check:ci": "node scripts/gradle.mjs check",
		"web:dev": "bun run --filter @minemories/web dev",
		"web:check": "biome check apps/web && bun run --filter @minemories/web typecheck && bun run --filter @minemories/web test:coverage",
		"web:build": "bun run --filter @minemories/web bundle",
		"api:dev": "bun run --filter @minemories/api dev",
		"api:reconcile": "bun run --filter @minemories/api reconcile",
		"api:diagnostics": "bun run --cwd apps/api diagnostics",
		"api:admin": "bun run --cwd apps/api admin",
		"api:archive:plan": "bun run --cwd apps/api archive:plan",
		"api:check": "biome check apps/api packages/api-contract && bun run --filter @minemories/api typecheck && bun run --filter @minemories/api test",
		"format": "biome check --write apps scripts package.json biome.json",
		"lint": "biome check apps scripts package.json biome.json",
		"check": "bun run lint && bun run package:mod:test && bun run release:test && bun run api:coverage:test && bun run web:check && bun run api:check && bun run mod:check:ci",
		"build": "bun run check && bun run mod:build && bun run package:mod:all && bun run package:mod && bun run web:build",
		"package:mod": "node scripts/package-mod.mjs",
		"package:mod:test": "node --test scripts/package-mod.test.mjs scripts/verify-mod-artifact.test.mjs scripts/build-web.test.mjs scripts/prerender-web.test.mjs",
		"api:garage": "node scripts/garage-integration.mjs",
		"api:coverage:test": "node --test scripts/check-api-coverage.test.mjs",
		"release:test": "node --test scripts/release-utils.test.mjs scripts/sync-release-versions.test.mjs scripts/release-flow.test.mjs scripts/release-assets.test.mjs",
		"package:mod:all": "node scripts/package-mod.mjs --all"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@release-it/conventional-changelog": "12.0.2",
		"release-it": "21.1.1"
	},
	"overrides": {
		"basic-ftp": "6.2.3"
	},
	"version": "0.14.0-beta.1"
}
