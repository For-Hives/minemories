{
	"$schema": "https://schema.railpack.com",
	"packages": {
		"bun": "1.4.2"
	},
	"steps": {
		"install": {
			"inputs": [{ "step": "packages:mise" }, { "local": true, "include": ["."] }],
			"commands": ["bun install --frozen-lockfile"]
		},
		"build": {
			"inputs": [{ "step": "install", "include": ["."] }],
			"commands": ["bun run --filter @minemories/web build"]
		}
	}
}
