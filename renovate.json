{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"dependencyDashboardAutoclose": true,
	"customDatasources": {
		"minecraft": {
			"format": "json",
			"transformTemplates": ["{\"releases\": versions[type=\"release\"].{\"version\": id}}"]
		}
	},
	"packageRules": [
		{
			"description": "Runtime target follows mod/targets.json; changing it requires in-game validation.",
			"matchPackageNames": ["com.mojang:minecraft"],
			"allowedVersions": "/^1\\.21\\.1$/",
			"overrideDatasource": "custom.minecraft",
			"versioning": "semver",
			"registryUrls": ["https://piston-meta.mojang.com/mc/game/version_manifest_v2.json"]
		},
		{
			"description": "Runtime target follows mod/targets.json; changing it requires in-game validation.",
			"matchPackageNames": ["net.fabricmc:fabric-loader"],
			"allowedVersions": "/^0\\.19\\.5$/",
			"registryUrls": ["https://maven.fabricmc.net/"]
		},
		{
			"description": "Runtime target follows mod/targets.json; changing it requires in-game validation.",
			"matchPackageNames": ["net.fabricmc.fabric-api:fabric-api"],
			"allowedVersions": "/^0\\.116\\.17\\+1\\.21\\.1$/",
			"registryUrls": ["https://maven.fabricmc.net/"]
		},
		{
			"description": "Runtime target follows mod/targets.json; changing it requires in-game validation.",
			"matchPackageNames": ["net.minecraftforge:forge"],
			"allowedVersions": "/^1\\.21\\.1\\-52\\.1\\.19$/",
			"registryUrls": ["https://maven.minecraftforge.net/"]
		},
		{
			"description": "Each mod/<minecraft version>/ folder pins its own Minecraft, loader and Fabric API versions (mod/targets.json); never move them to another Minecraft version.",
			"matchFileNames": ["mod/**"],
			"matchPackageNames": [
				"com.mojang:minecraft",
				"net.fabricmc:fabric-loader",
				"net.fabricmc.fabric-api:fabric-api",
				"net.minecraftforge:forge"
			],
			"enabled": false
		},
		{
			"description": "Only the 1.21.1 root and the shared code follow the pinned 1.21.1 versions above.",
			"matchFileNames": ["mod/1.21.1/**", "mod/shared/**"],
			"matchPackageNames": [
				"com.mojang:minecraft",
				"net.fabricmc:fabric-loader",
				"net.fabricmc.fabric-api:fabric-api",
				"net.minecraftforge:forge"
			],
			"enabled": true
		}
	]
}
