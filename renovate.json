{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"dependencyDashboardAutoclose": true,
	"customDatasources": {
		"minecraft": {
			"format": "json",
			"transformTemplates": ["{\"releases\": versions[type=\"release\"].{\"version\": id}}"]
		}
	},
	"packageRules": [
		{
			"description": "Runtime target follows config/mod-targets.json; changing it requires in-game validation.",
			"matchPackageNames": ["com.mojang:minecraft"],
			"allowedVersions": "/^1\\.21\\.1$/",
			"overrideDatasource": "custom.minecraft",
			"versioning": "semver",
			"registryUrls": ["https://piston-meta.mojang.com/mc/game/version_manifest_v2.json"]
		},
		{
			"description": "Runtime target follows config/mod-targets.json; changing it requires in-game validation.",
			"matchPackageNames": ["net.fabricmc:fabric-loader"],
			"allowedVersions": "/^0\\.19\\.5$/",
			"registryUrls": ["https://maven.fabricmc.net/"]
		},
		{
			"description": "Runtime target follows config/mod-targets.json; changing it requires in-game validation.",
			"matchPackageNames": ["net.fabricmc.fabric-api:fabric-api"],
			"allowedVersions": "/^0\\.116\\.17\\+1\\.21\\.1$/",
			"registryUrls": ["https://maven.fabricmc.net/"]
		},
		{
			"description": "Runtime target follows config/mod-targets.json; changing it requires in-game validation.",
			"matchPackageNames": ["net.minecraftforge:forge"],
			"allowedVersions": "/^1\\.21\\.1\\-52\\.1\\.19$/",
			"registryUrls": ["https://maven.minecraftforge.net/"]
		}
	]
}
