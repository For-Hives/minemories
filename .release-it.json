{
	"git": {
		"requireBranch": "main",
		"requireCleanWorkingDir": true,
		"requireUpstream": true,
		"requireCommits": true,
		"getLatestTagFromAllRefs": true,
		"tagMatch": "mod-v*",
		"tagName": "mod-v${version}",
		"commitMessage": "chore(release): ${version} [skip ci]",
		"pushArgs": [
			"--atomic",
			"--follow-tags"
		]
	},
	"npm": false,
	"github": false,
	"gitlab": false,
	"hooks": {
		"after:bump": [
			"node scripts/sync-release-versions.mjs ${version}",
			"bun install --lockfile-only --ignore-scripts",
			"bun install --frozen-lockfile --ignore-scripts"
		]
	},
	"plugins": {
		"@release-it/conventional-changelog": {
			"preset": {
				"name": "conventionalcommits",
				"types": [
					{
						"type": "feat",
						"section": "Fonctionnalités"
					},
					{
						"type": "fix",
						"section": "Corrections"
					},
					{
						"type": "perf",
						"section": "Performances"
					},
					{
						"type": "refactor",
						"section": "Refactorisation"
					},
					{
						"type": "build",
						"section": "Build"
					},
					{
						"type": "ci",
						"section": "Intégration continue"
					},
					{
						"type": "docs",
						"section": "Documentation"
					},
					{
						"type": "test",
						"section": "Tests"
					},
					{
						"type": "chore",
						"section": "Maintenance"
					}
				]
			},
			"strictSemVer": true,
			"infile": "CHANGELOG.md"
		}
	}
}
