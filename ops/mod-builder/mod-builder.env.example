# Copy to /etc/minemories/mod-builder.env (root:minemories, mode 0640). Read by the systemd units through
# EnvironmentFile: no quotes, no `export`. Never commit the real file. Empty values disable the feature
# (no Discord message, no third-party publication, ...).

# --- Discord ---------------------------------------------------------------------------------------------------
# Channel webhook for build/test/release notifications (`bun mod notify --test` checks it).
MOD_DISCORD_WEBHOOK_URL=

# --- Third-party publication (inactive until the projects exist: see mod/catalogs.json) ------------------------
MODRINTH_TOKEN=
CURSEFORGE_TOKEN=

# --- S3 storage of the built JARs: the exact variable names are owned by `bun mod` storage (scripts/mod/storage) --
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Headless tests --------------------------------------------------------------------------------------------
# Heap of every JVM of the in-game tests (default 2048 MB), timeout per target in seconds (default 1500).
# MOD_TEST_GAME_MEMORY_MB=2048
# MOD_TEST_TIMEOUT_SECONDS=1500
# JDKs outside ~/.local/tools (the install script puts them there):
# MOD_JDK_8=/opt/jdk8
# MOD_JDK_17=/opt/jdk17
# MOD_JDK_21=/opt/jdk21
# MOD_JDK_25=/opt/jdk25
