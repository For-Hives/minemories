{
	"name": "@minemories/api",
	"private": true,
	"version": "0.36.0-beta.1",
	"type": "module",
	"scripts": {
		"dev": "bun --env-file=../../.env --watch src/index.ts",
		"start": "bun src/index.ts",
		"reconcile": "bun --env-file=../../.env src/reconcile-cli.ts",
		"diagnostics": "bun --env-file=../../.env src/diagnostics-cli.ts",
		"admin": "bun --env-file=../../.env src/admin-cli.ts",
		"archive:plan": "bun --env-file=../../.env src/cold-storage-cli.ts",
		"test": "bun test src --parallel --coverage && node ../../scripts/check-api-coverage.mjs",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"seed": "bun --env-file=../../.env scripts/seed-dev.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "3.1164.0",
		"@aws-sdk/lib-storage": "3.1164.0",
		"@minemories/api-contract": "workspace:*",
		"@minemories/mod-storage": "workspace:*",
		"@orpc/server": "^1.14.0",
		"@polar-sh/better-auth": "2.1.4",
		"@polar-sh/sdk": "1.0.2",
		"better-auth": "^1.6.0",
		"hono": "^4.9.0",
		"meshoptimizer": "1.3.0",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@orpc/client": "^1.14.0",
		"@orpc/contract": "^1.14.0",
		"@types/bun": "^1.2.0",
		"typescript": "7.0.2"
	}
}
