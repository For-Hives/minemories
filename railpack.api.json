{
	"$schema": "https://schema.railpack.com",
	"packages": {
		"bun": "1.4.3"
	},
	"steps": {
		"install": {
			"inputs": [{ "step": "packages:mise" }, { "local": true, "include": ["."] }],
			"commands": ["bun install --frozen-lockfile"]
		},
		"build": {
			"inputs": [{ "step": "install" }],
			"commands": ["bun run --filter @minemories/api typecheck"]
		}
	},
	"deploy": {
		"startCommand": "bun run --filter @minemories/api start"
	}
}
